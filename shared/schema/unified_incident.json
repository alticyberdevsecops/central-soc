{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UnifiedIncident",
    "description": "Central SOC normalized incident schema — vendor-agnostic",
    "type": "object",
    "required": [
        "tenant_id",
        "source_vendor",
        "vendor_incident_id",
        "title",
        "severity",
        "status"
    ],
    "properties": {
        "tenant_id": {
            "type": "string",
            "format": "uuid",
            "description": "Customer tenant UUID"
        },
        "source_vendor": {
            "type": "string",
            "enum": [
                "xsiam",
                "crowdstrike",
                "sentinelone",
                "defender",
                "varonis",
                "splunk",
                "qradar",
                "generic"
            ],
            "description": "EDR/XDR platform that generated this incident"
        },
        "vendor_incident_id": {
            "type": "string",
            "description": "Original incident ID from the vendor platform"
        },
        "vendor_url": {
            "type": "string",
            "format": "uri",
            "description": "Deep-link back to vendor console for this incident"
        },
        "title": {
            "type": "string",
            "description": "Short incident title"
        },
        "description": {
            "type": "string",
            "description": "Detailed incident description"
        },
        "severity": {
            "type": "string",
            "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "informational"
            ],
            "description": "Normalized severity across all vendors"
        },
        "status": {
            "type": "string",
            "enum": [
                "new",
                "triaging",
                "in_progress",
                "resolved",
                "false_positive",
                "escalated"
            ],
            "default": "new"
        },
        "affected_hosts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "hostname": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "os": {
                        "type": "string"
                    },
                    "agent_id": {
                        "type": "string"
                    },
                    "domain": {
                        "type": "string"
                    }
                }
            },
            "description": "List of affected host endpoints"
        },
        "affected_users": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "domain": {
                        "type": "string"
                    },
                    "user_sid": {
                        "type": "string"
                    }
                }
            },
            "description": "List of affected user accounts"
        },
        "iocs": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "value"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "ip",
                            "domain",
                            "url",
                            "file_hash_md5",
                            "file_hash_sha256",
                            "email",
                            "process",
                            "registry_key",
                            "cve"
                        ]
                    },
                    "value": {
                        "type": "string"
                    },
                    "context": {
                        "type": "string"
                    },
                    "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    }
                }
            },
            "description": "Indicators of Compromise"
        },
        "mitre_tactics": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "MITRE ATT&CK tactic IDs (e.g. TA0001)"
        },
        "mitre_techniques": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "MITRE ATT&CK technique IDs (e.g. T1566.001)"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "raw_payload": {
            "type": "object",
            "description": "Original unmodified vendor payload stored for audit purposes"
        },
        "source_created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp from vendor when incident was created"
        }
    }
}