# ═══════════════════════════════════════════════════
#  Central SOC Dashboard — Environment Configuration
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=soc_secret_2024
POSTGRES_DB=central_soc

# ── Redis ───────────────────────────────────────────
REDIS_PASSWORD=redis_secret_2024

# ── JWT Auth ────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_super_secret_jwt_key_2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── XSIAM Connector (per tenant — set in DB connector_configs) ──
# These are example keys. Real keys are stored per-tenant in the DB.
# XSIAM_BASE_URL=https://your-tenant.xdr.us.paloaltonetworks.com
# XSIAM_API_KEY=your-xsiam-api-key
# XSIAM_API_KEY_ID=your-xsiam-api-key-id

# ── CrowdStrike Connector ───────────────────────────
# CROWDSTRIKE_CLIENT_ID=your-client-id
# CROWDSTRIKE_CLIENT_SECRET=your-client-secret
# CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# ── SentinelOne Connector ───────────────────────────
# SENTINELONE_API_TOKEN=your-api-token
# SENTINELONE_BASE_URL=https://your-tenant.sentinelone.net

# ── Microsoft Defender Connector ───────────────────
# DEFENDER_TENANT_ID=your-azure-tenant-id
# DEFENDER_CLIENT_ID=your-app-client-id
# DEFENDER_CLIENT_SECRET=your-app-client-secret

# ── Seed Data Password ─────────────────────────────
SEED_SUPER_ADMIN_PASSWORD=Admin@SOC2024!
SEED_ANALYST_PASSWORD=Analyst@SOC2024!
